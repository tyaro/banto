{
  "name": "banto-external-consumer",
  "private": true,
  "version": "0.0.0",
  "description": "外部利用 fixture（#271）: @banto/* を Git 依存 + path: で導入し、dev 起動・check・build を CI で確かめる最小の SvelteKit アプリ",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@banto/admin-core": "github:tyaro/banto#v4.0.0&path:packages/admin-core",
    "@banto/dock-svelte": "github:tyaro/banto#v4.0.0&path:packages/dock-svelte",
    "@banto/forms": "github:tyaro/banto#v4.0.0&path:packages/forms",
    "@banto/grid-svelte": "github:tyaro/banto#v4.0.0&path:packages/grid-svelte",
    "@banto/theme": "github:tyaro/banto#v4.0.0&path:packages/theme",
    "@banto/tree-svelte": "github:tyaro/banto#v4.0.0&path:packages/tree-svelte"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.0",
    "vite": "^8.3.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
