{
  "name": "banto-external-consumer",
  "private": true,
  "version": "0.0.0",
  "description": "外部利用 fixture（#271）: @banto/* を Git 依存 + path: で導入し、dev 起動・check・build を CI で確かめる最小の SvelteKit アプリ",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "test": "svelte-kit sync && vitest run",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@banto/admin-core": "github:tyaro/banto#v9.1.0&path:packages/admin-core",
    "@banto/charts": "github:tyaro/banto#v9.1.0&path:packages/charts",
    "@banto/dock-svelte": "github:tyaro/banto#v9.1.0&path:packages/dock-svelte",
    "@banto/forms": "github:tyaro/banto#v9.1.0&path:packages/forms",
    "@banto/grid-svelte": "github:tyaro/banto#v9.1.0&path:packages/grid-svelte",
    "@banto/image-assets": "github:tyaro/banto#v9.1.0&path:packages/image-assets",
    "@banto/theme": "github:tyaro/banto#v9.1.0&path:packages/theme",
    "@banto/touch-keys-svelte": "github:tyaro/banto#v9.1.0&path:packages/touch-keys-svelte",
    "@banto/tree-svelte": "github:tyaro/banto#v9.1.0&path:packages/tree-svelte",
    "@banto/ui": "github:tyaro/banto#v9.1.0&path:packages/ui"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.0.0",
    "jsdom": "^31.0.0",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
