{
  "$comment": "Shared `between` filter contract (date-time-pickers §5.9, D12): the half-open [from, to) compared as text, a null end drops that side, both null is no condition. Asserted by banto-storage (SQLite + PostgreSQL, list_query.rs), the InMemory DataProvider (packages/admin-core/tests/listOrderParity.test.ts) and the grid's client filter (packages/grid-svelte/tests/filterBetween.test.ts). `day` holds canonical dates, `at` canonical dates and times (one with seconds). `cases` list the matching ids in id order; `invalid` values are a BadRequest in SQL and match no row on the client.",
  "rows": [
    { "id": 1, "day": "2024-02-28", "at": "2024-02-28T23:59" },
    { "id": 2, "day": "2024-02-29", "at": "2024-02-29T00:00" },
    { "id": 3, "day": "2024-03-01", "at": "2024-03-01T09:30" },
    { "id": 4, "day": "2025-12-31", "at": "2025-12-31T23:59" },
    { "id": 5, "day": "2026-01-01", "at": "2026-01-01T00:00" },
    { "id": 6, "day": null, "at": null },
    { "id": 7, "day": "2026-11-07", "at": "2026-11-07T23:59:30" }
  ],
  "cases": [
    {
      "name": "the leap day alone",
      "field": "day",
      "value": ["2024-02-29", "2024-03-01"],
      "expectedIds": [2]
    },
    {
      "name": "the leap day on a date-and-time column",
      "field": "at",
      "value": ["2024-02-29", "2024-03-01"],
      "expectedIds": [2]
    },
    {
      "name": "across a month end",
      "field": "day",
      "value": ["2024-02-28", "2024-03-02"],
      "expectedIds": [1, 2, 3]
    },
    {
      "name": "the last day of a year excludes the next midnight",
      "field": "at",
      "value": ["2025-12-31", "2026-01-01"],
      "expectedIds": [4]
    },
    { "name": "from only", "field": "day", "value": ["2026-01-01", null], "expectedIds": [5, 7] },
    { "name": "to only", "field": "day", "value": [null, "2024-03-01"], "expectedIds": [1, 2] },
    {
      "name": "no end at all keeps every row, null too",
      "field": "day",
      "value": [null, null],
      "expectedIds": [1, 2, 3, 4, 5, 6, 7]
    },
    {
      "name": "from after to is empty",
      "field": "day",
      "value": ["2026-01-01", "2025-01-01"],
      "expectedIds": []
    },
    {
      "name": "from equal to to is empty",
      "field": "day",
      "value": ["2026-01-01", "2026-01-01"],
      "expectedIds": []
    },
    {
      "name": "a value with seconds is still in its day",
      "field": "at",
      "value": ["2026-11-07", "2026-11-08"],
      "expectedIds": [7]
    },
    {
      "name": "date-and-time ends on a date-and-time column",
      "field": "at",
      "value": ["2024-02-28T23:59", "2024-03-01T09:30"],
      "expectedIds": [1, 2]
    }
  ],
  "invalid": [
    { "name": "not an array", "value": "2026-01-01" },
    { "name": "one element", "value": ["2026-01-01"] },
    { "name": "three elements", "value": ["2026-01-01", "2026-01-02", null] },
    { "name": "a number end", "value": [20260101, null] },
    { "name": "an object end", "value": [null, { "to": "2026-01-01" }] }
  ]
}
