{
  "name": "admin-template",
  "private": true,
  "version": "7.0.0",
  "type": "module",
  "banto": {
    "i18n": "keys"
  },
  "scripts": {
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy custom-banto baseLocale --emit-ts-declarations && node ../../scripts/check-i18n-nonempty.mjs",
    "predev": "pnpm paraglide:compile",
    "dev": "vite dev",
    "prebuild": "pnpm paraglide:compile",
    "build": "vite build",
    "preview": "vite preview",
    "check": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:build:windows": "tauri build --features embed-ui --config src-tauri/tauri.fw-elev.conf.json"
  },
  "dependencies": {
    "@banto/admin-core": "workspace:*",
    "@banto/attachments": "workspace:*",
    "@banto/charts": "workspace:*",
    "@banto/dock-svelte": "workspace:*",
    "@banto/forms": "workspace:*",
    "@banto/grid-svelte": "workspace:*",
    "@banto/report": "workspace:*",
    "@banto/theme": "workspace:*",
    "@banto/tree-svelte": "workspace:*",
    "@banto/ui": "workspace:*",
    "@lucide/svelte": "^1.69.0",
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^3.1.0",
    "@inlang/plugin-m-function-matcher": "2.4.3",
    "@inlang/plugin-message-format": "4.6.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
