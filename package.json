{
  "name": "banto",
  "private": true,
  "version": "0.0.0",
  "description": "Banto — full-stack admin framework/template for Tauri v2 + SvelteKit",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tauri-apps/cli"
    ]
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter admin-template dev",
    "build": "pnpm --filter admin-template build",
    "check": "pnpm --recursive --if-present check && pnpm check:e2e",
    "check:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "test": "pnpm --recursive --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "scaffold": "node scripts/scaffold.mjs",
    "banto": "node scripts/banto.mjs",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:migrations": "node scripts/verify-migrations-frozen.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:doc-links": "node scripts/check-doc-links.mjs",
    "sync:datetime-core": "node scripts/sync-datetime-core.mjs",
    "check:datetime-core": "node scripts/sync-datetime-core.mjs --check",
    "e2e": "playwright test --config=e2e/playwright.config.ts --project=chromium",
    "e2e:visual": "playwright test --config=e2e/playwright.config.ts --project=visual",
    "e2e:visual-ui": "playwright test --config=e2e/playwright.config.ts --project=visual-ui",
    "e2e:demo": "playwright test --config=e2e/playwright.config.ts --project=demo",
    "e2e:public-viewer": "playwright test --config=e2e/playwright.config.ts --project=public-viewer --project=public-viewer-login",
    "e2e:add-resource": "playwright test --config=e2e/playwright.config.ts --project=add-resource",
    "e2e:touch-keys": "playwright test --config=packages/touch-keys-svelte/tests/browser/playwright.config.ts",
    "bench": "pnpm --recursive --if-present bench",
    "test:rename": "node --test scripts/rename.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.0.0",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.73.0"
  }
}
